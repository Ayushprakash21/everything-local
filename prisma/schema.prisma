// 2. Standalone Delivery Partner Application Models
model RiderProfile {
  id                    String                @id @default(uuid())
  userId                String                @unique
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  riderCode             String                @unique // e.g. EL-RIDER-IND-101
  vehicleType           String                @default("MOTORCYCLE") // BICYCLE, MOTORCYCLE, SCOOTER, EV
  vehicleNumber         String
  drivingLicenceNumber  String
  panNumber             String?
  bankAccountNumber     String?
  bankIfsc              String?
  emergencyContactName  String?
  emergencyContactPhone String?
  isVerified            Boolean               @default(true)
  isActive              Boolean               @default(true)
  isOnline              Boolean               @default(false)
  currentLatitude       Float?
  currentLongitude      Float?
  rating                Float                 @default(4.9)
  totalDeliveries       Int                   @default(0)
  approvalStatus        String                @default("APPROVED") // APPLIED, UNDER_REVIEW, APPROVED, SUSPENDED, REJECTED
  serviceArea           String                @default("Indore - All Zones")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  tasks                 DeliveryTask[]
  earnings              RiderEarningLedger[]
  settlements           RiderSettlement[]
  documents             DeliveryPartnerDocument[]
  vehicles              DeliveryPartnerVehicle[]
  availabilities        DeliveryPartnerAvailability[]
  assignments           DeliveryAssignment[]
  locations             DeliveryLocation[]
  incidents             DeliveryIncident[]
}

model DeliveryTask {
  id                         String              @id @default(uuid())
  taskNumber                 String              @unique // e.g. EL-TASK-84920
  parentOrderId              String?
  parentOrder                ParentOrder?        @relation(fields: [parentOrderId], references: [id], onDelete: SetNull)
  merchantOrderId            String?
  merchantOrder              MerchantChildOrder? @relation(fields: [merchantOrderId], references: [id], onDelete: SetNull)
  riderId                    String?
  rider                      RiderProfile?       @relation(fields: [riderId], references: [id], onDelete: SetNull)
  status                     String              @default("AVAILABLE") // AVAILABLE, OFFERED, ACCEPTED, AT_STORE, PICKED_UP, EN_ROUTE, DELIVERED, REJECTED, EXPIRED, CANCELLED, REASSIGNED, FAILED_DELIVERY, RETURN_REQUIRED
  priorityTier               String              @default("STANDARD_60") // EXPRESS_20, PRIORITY_40, STANDARD_60, SCHEDULED_120
  pickupLocationName         String
  pickupAddress              String
  pickupLatitude             Float
  pickupLongitude            Float
  deliveryAddress            String
  deliveryLatitude           Float
  deliveryLongitude          Float
  estimatedDistanceKm        Float               @default(2.5)
  estimatedMinutes           Int                 @default(30)
  riderBasePayoutPaise       Int                 @default(3000) // ₹30.00
  additionalPickupPayoutPaise Int                @default(0)
  waitingPayoutPaise         Int                 @default(0)
  surgePayoutPaise           Int                 @default(0)
  totalPayoutPaise           Int                 @default(3000)
  pickupOtp                  String              // 4-digit code for merchant handover
  deliveryOtp                String              // 4-digit code for customer handover
  deliveryOtpHashed          String?
  deliveryOtpExpiresAt       DateTime?
  deliveryOtpAttempts        Int                 @default(0)
  deliveryOtpMaxAttempts     Int                 @default(5)
  pickupOtpHashed            String?
  version                    Int                 @default(1)
  acceptanceDeadline         DateTime?
  cancellationReason         String?
  specialHandling            String?
  acceptedAt                 DateTime?
  atStoreAt                  DateTime?
  pickedUpAt                 DateTime?
  deliveredAt                DateTime?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  earningEntries             RiderEarningLedger[]
  assignments                DeliveryAssignment[]
  locations                  DeliveryLocation[]
  statusHistories            DeliveryStatusHistory[]
  proofs                     DeliveryProof[]
  incidents                  DeliveryIncident[]
}

model DeliveryPartnerDocument {
  id                 String       @id @default(uuid())
  partnerId          String
