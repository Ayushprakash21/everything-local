model DeliveryAssignment {
  id                     String       @id @default(uuid())
  taskId                 String
  task                   DeliveryTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  partnerId              String
  partner                RiderProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  status                 String       @default("OFFERED") // OFFERED, ACCEPTED, DECLINED, TIMED_OUT, REVOKED
  offeredAt              DateTime     @default(now())
