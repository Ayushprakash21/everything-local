datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  phone        String?           @unique
  name         String
  passwordHash String
  role         String            @default("CUSTOMER") // CUSTOMER, MERCHANT, ADMIN
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  addresses    CustomerAddress[]
  stores       Store[]           @relation("UserStores")
  orders       Order[]           @relation("CustomerOrders")
  carts        Cart[]
  reviews      Review[]
  auditLogs    AuditLog[]

  serviceProviders ServiceProvider[]  @relation("UserProviders")
  serviceBookings  ServiceBooking[]   @relation("CustomerBookings")
  serviceReviews   ServiceReview[]    @relation("CustomerServiceReviews")

  pharmacies       Pharmacy[]         @relation("UserPharmacies")
  prescriptions    Prescription[]     @relation("CustomerPrescriptions")
  pharmacyOrders   PharmacyOrder[]    @relation("CustomerPharmacyOrders")
}

model Store {
  id                String                 @id @default(uuid())
  ownerId           String
  owner             User                   @relation("UserStores", fields: [ownerId], references: [id], onDelete: Cascade)
  name              String
  slug              String                 @unique
  description       String?
  category          String                 @default("grocery") // grocery, produce, bakery, dairy, electronics, stationery, fashion, etc.
  addressLine       String
  city              String                 @default("Indore")
  pincode           String
  latitude          Float
  longitude         Float
  serviceRadiusKm   Float                  @default(3.0)
  isOpen            Boolean                @default(true)
  isVerified        Boolean                @default(false)
  commissionRatePct Float                  @default(3.5) // Default 3.5%
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  products          Product[]
  orders            Order[]
  ledgerEntries     FinancialLedgerEntry[]
  subscriptions     MerchantSubscription[]
  reviews           Review[]
  carts             Cart[]
}

model Product {
  id          String      @id @default(uuid())
  storeId     String
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String
  mrpPaise    Int         // Integer paise
  pricePaise  Int         // Integer paise
  stock       Int         @default(0)
  isAvailable Boolean     @default(true)
  imageUrl    String?
  sku         String?
  barcode     String?
  brand       String?
  packageSize String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  cartItems   CartItem[]
  orderItems  OrderItem[]
}

model CustomerAddress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String   @default("Home") // Home, Work, Other
  addressLine String
  landmark    String?
  city        String   @default("Indore")
  pincode     String
  latitude    Float
  longitude   Float
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Cart {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String?
  store     Store?     @relation(fields: [storeId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     CartItem[]
}

model CartItem {
  id             String   @id @default(uuid())
  cartId         String
  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity       Int      @default(1)
  unitPricePaise Int
}

model Order {
  id                   String                 @id @default(uuid())
  orderNumber          String                 @unique
  customerId           String
  customer             User                   @relation("CustomerOrders", fields: [customerId], references: [id])
  storeId              String
  store                Store                  @relation(fields: [storeId], references: [id])
  status               String                 @default("PLACED") // PLACED, ACCEPTED, REJECTED, PREPARING, READY_FOR_PICKUP, OUT_FOR_DELIVERY, DELIVERED, COLLECTED, CANCELLED, REFUNDED
  fulfillmentMode      String                 @default("PICKUP") // PICKUP, MERCHANT_DELIVERY, PLATFORM_DELIVERY
  deliveryAddressId    String?
  
  // Financial Snapshot in Integer Paise
  itemSubtotalPaise    Int
  deliveryFeePaise     Int                    @default(0)
  taxPaise             Int                    @default(0)
  discountPaise        Int                    @default(0)
  totalAmountPaise     Int
  commissionPaise      Int
  merchantPayablePaise Int
  platformRevenuePaise Int
  
  idempotencyKey       String?                @unique
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  items                OrderItem[]
  events               OrderEvent[]
  ledgerEntries        FinancialLedgerEntry[]
  reviews              Review[]
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  productName    String
  quantity       Int
  unitPricePaise Int
  totalPricePaise Int
}

model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  actorId   String?
  note      String?
  createdAt DateTime @default(now())
}

model FinancialLedgerEntry {
  id                 String   @id @default(uuid())
  orderId            String?
  order              Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  storeId            String
  store              Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  entryType          String   // ORDER_SALE, COMMISSION_FEE, REFUND_DEBIT, PAYOUT_SETTLEMENT
  amountPaise        Int
  runningBalancePaise Int     @default(0)
  reference          String?
  createdAt          DateTime @default(now())
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  valueJson   String
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String?
  detailsJson  String?
  ipAddress    String?
  createdAt    DateTime @default(now())
}

model MerchantSubscription {
  id                String   @id @default(uuid())
  storeId           String
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  planName          String   // Basic, Growth, Pro
  monthlyPricePaise Int
  status            String   @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  startsAt          DateTime @default(now())
  expiresAt         DateTime
}

model Review {
  id         String   @id @default(uuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int      // 1 to 5
  comment    String?
  createdAt  DateTime @default(now())
}

// ==========================================
// LOCAL SERVICES ECOSYSTEM MODELS
// ==========================================

model ServiceCategory {
  id           String           @id @default(uuid())
  name         String
  slug         String           @unique
  icon         String           // e.g. "✂️", "💄", "🔧", "🧹", "🚗", "📚"
  description  String?
  displayOrder Int              @default(0)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  services     ServiceListing[]
}

model ServiceProvider {
  id                  String                 @id @default(uuid())
  ownerId             String
  owner               User                   @relation("UserProviders", fields: [ownerId], references: [id], onDelete: Cascade)
  businessName        String
  slug                String                 @unique
  description         String?
  profileImageUrl     String?
  contactPhone        String
  contactEmail        String?
  categorySlug        String                 // Primary category (e.g. salon, home-maintenance, cleaning)
  isVerified          Boolean                @default(false)
  verificationStatus  String                 @default("PENDING") // PENDING, VERIFIED, REJECTED, SUSPENDED
  kycDocumentUrl      String?
  commissionRatePct   Float                  @default(10.0) // Configurable platform commission rate
  rating              Float                  @default(4.9)
  reviewCount         Int                    @default(0)
  
  // Shop Visit configuration
  hasShopVisit        Boolean                @default(true)
  shopAddressLine     String?
  shopCity            String                 @default("Indore")
  shopPincode         String?
  shopLatitude        Float?
  shopLongitude       Float?

  // Home Visit configuration
  hasHomeVisit        Boolean                @default(true)
  homeVisitRadiusKm   Float                  @default(7.0) // Independent radius for services (e.g. 7-10 km)
  homeVisitFeePaise   Int                    @default(0)   // Travel / visit fee in paise (e.g. ₹9900 or 0)
  
  isOpen              Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  staff               ProviderStaff[]
  services            ServiceListing[]
  serviceAreas        ServiceArea[]
  availabilities      ProviderAvailability[]
  appointmentSlots    AppointmentSlot[]
  bookings            ServiceBooking[]
  reviews             ServiceReview[]
  earnings            ProviderEarning[]
}

model ProviderStaff {
  id               String            @id @default(uuid())
  providerId       String
  provider         ServiceProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name             String
  role             String            // e.g. "Senior Stylist", "AC Technician", "Master Electrician"
  phone            String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())

  bookings         ServiceBooking[]
  appointmentSlots AppointmentSlot[]
}

model ServiceListing {
  id                  String           @id @default(uuid())
  providerId          String
  provider            ServiceProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  categoryId          String
  category            ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  imageUrl            String?
  pricePaise          Int              // Integer paise (e.g. 29900 = ₹299)
  mrpPaise            Int?             // Integer paise (e.g. 39900 = ₹399)
  pricingType         String           @default("FIXED") // FIXED, STARTING_FROM, INSPECTION_FEE
  durationMinutes     Int              @default(45)
  allowsShopVisit     Boolean          @default(true)
  allowsHomeVisit     Boolean          @default(true)
  materialIncluded    Boolean          @default(false)
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  bookings            ServiceBooking[]
}

model ServiceArea {
  id          String          @id @default(uuid())
  providerId  String
  provider    ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  locality    String          // e.g. "Vijay Nagar", "Palasia", "All Indore"
  pincode     String?
}

model ProviderAvailability {
  id                  String          @id @default(uuid())
  providerId          String
  provider            ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dayOfWeek           Int             // 0 (Sun) to 6 (Sat)
  startTime           String          // e.g. "09:00"
  endTime             String          // e.g. "20:00"
  slotDurationMinutes Int             @default(60)
  isDayOff            Boolean         @default(false)
}

model AppointmentSlot {
  id          String          @id @default(uuid())
  providerId  String
  provider    ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  staffId     String?
  staff       ProviderStaff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)
  date        String          // YYYY-MM-DD
  timeSlot    String          // e.g. "10:00 AM"
  isBooked    Boolean         @default(false)
  bookingId   String?
  createdAt   DateTime        @default(now())

  @@unique([providerId, date, timeSlot])
}

model ServiceBooking {
  id                    String              @id @default(uuid())
  bookingNumber         String              @unique // BKG-IND-XXXXXX
  customerId            String
  customer              User                @relation("CustomerBookings", fields: [customerId], references: [id])
  providerId            String
  provider              ServiceProvider     @relation(fields: [providerId], references: [id])
  serviceId             String
  service               ServiceListing      @relation(fields: [serviceId], references: [id])
  staffId               String?
  staff                 ProviderStaff?      @relation(fields: [staffId], references: [id])
  
  fulfillmentType       String              // SHOP_VISIT or HOME_VISIT
  bookingDate           String              // YYYY-MM-DD
  timeSlot              String              // e.g. "10:00 AM"
  status                String              @default("PENDING_CONFIRMATION") 
  // PENDING_CONFIRMATION, CONFIRMED, PROVIDER_ASSIGNED, PROVIDER_EN_ROUTE, ARRIVED, IN_PROGRESS, COMPLETED, CANCELLED, REJECTED, NO_SHOW, REFUNDED

  // Customer location for Home Visit
  customerAddressLine   String?
  customerLocality      String?
  customerCity          String              @default("Indore")
  customerPincode       String?
  customerLat           Float?
  customerLng           Float?
  instructions          String?

  // Financial Snapshot in Integer Paise
  serviceFeePaise       Int
  travelFeePaise        Int                 @default(0)
  materialFeePaise      Int                 @default(0)
  discountPaise         Int                 @default(0)
  totalAmountPaise      Int
  commissionPaise       Int
  providerPayablePaise  Int
  platformRevenuePaise  Int
  paymentStatus         String              @default("PENDING") // PENDING, PAID, REFUNDED
  cancellationReason    String?

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  events                BookingStatusEvent[]
  review                ServiceReview?
  payment               ServicePayment?
}

model BookingStatusEvent {
  id          String         @id @default(uuid())
  bookingId   String
  booking     ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status      String
  actorId     String?
  actorRole   String?        // CUSTOMER, PROVIDER, ADMIN, SYSTEM
  note        String?
  createdAt   DateTime       @default(now())
}

model ServiceReview {
  id          String          @id @default(uuid())
  bookingId   String          @unique
  booking     ServiceBooking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  providerId  String
  provider    ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customerId  String
  customer    User            @relation("CustomerServiceReviews", fields: [customerId], references: [id], onDelete: Cascade)
  rating      Int             // 1 to 5
  comment     String?
  createdAt   DateTime        @default(now())
}

model ProviderEarning {
  id                 String          @id @default(uuid())
  providerId         String
  provider           ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  bookingId          String?
  amountPaise        Int
  commissionPaise    Int
  netEarningPaise    Int
  payoutStatus       String          @default("PENDING") // PENDING, PROCESSED, WITHDRAWN
  reference          String?
  createdAt          DateTime        @default(now())
}

model ServicePayment {
  id             String         @id @default(uuid())
  bookingId      String         @unique
  booking        ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amountPaise    Int
  paymentMethod  String         @default("CASH_ON_SERVICE") // CASH_ON_SERVICE, UPI, CARD
  transactionRef String?
  status         String         @default("PAID") // PENDING, PAID, REFUNDED
  createdAt      DateTime       @default(now())
}

// ====================================================
// PHARMACY & MEDICAL ECOSYSTEM MODELS
// ====================================================

model Pharmacy {
  id                 String               @id @default(uuid())
  ownerId            String
  owner              User                 @relation("UserPharmacies", fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  legalBusinessName  String
  slug               String               @unique
  addressLine        String
  city               String               @default("Indore")
  pincode            String
  latitude           Float
  longitude          Float
  phone              String
  email              String
  operatingHours     String               @default("08:00 AM - 11:00 PM")
  serviceRadiusKm    Float                @default(5.0)
  isOpen             Boolean              @default(true)
  verificationStatus String               @default("UNDER_VERIFICATION") // APPLICATION_SUBMITTED, DOCUMENTS_PENDING, UNDER_VERIFICATION, APPROVED, REJECTED, SUSPENDED, LICENCE_EXPIRED
  isVerified         Boolean              @default(false)
  rejectionReason    String?
  counterPickup      Boolean              @default(true)
  homeDelivery       Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  licences           PharmacyLicence[]
  pharmacists        RegisteredPharmacist[]
  inventory          PharmacyInventory[]
  prescriptions      Prescription[]
  quotations         PharmacyQuotation[]
  orders             PharmacyOrder[]
}

model PharmacyLicence {
  id                 String    @id @default(uuid())
  pharmacyId         String
  pharmacy           Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  licenceType        String    // FORM_20, FORM_21, FORM_20B, FORM_21B
  licenceNumber      String    // e.g. "MP/IND/20/2023/10842"
  issuingAuthority   String    @default("Madhya Pradesh Food and Drugs Administration (FDA)")
  validFrom          DateTime
  validUpto          DateTime
  documentUrl        String?
  status             String    @default("PENDING") // PENDING, VERIFIED, EXPIRED, REVOKED
  verifiedAt         DateTime?
  verifiedByAdminId  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model RegisteredPharmacist {
  id                   String    @id @default(uuid())
  pharmacyId           String
  pharmacy             Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  userId               String?
  name                 String    // e.g. "Pooja Sharma, B.Pharm"
  registrationNumber   String    // e.g. "MPPC-48291"
  councilName          String    @default("Madhya Pradesh State Pharmacy Council")
  qualification        String    @default("B.Pharm / M.Pharm")
  registrationValidity DateTime
  isPrimary            Boolean   @default(true)
  isActive             Boolean   @default(true)
  phone                String
  email                String?
  certificateUrl       String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model MedicineClassification {
  id                    String   @id @default(uuid())
  code                  String   @unique // OTC, SCHEDULE_H, SCHEDULE_H1, SCHEDULE_X, CONTROLLED, MEDICAL_DEVICE, AYURVEDIC
  name                  String
  requiresPrescription  Boolean  @default(false)
  isOnlineSalePermitted Boolean  @default(true) // SCHEDULE_X is false
  description           String?
  regulatoryNotes       String?
}

model Medicine {
  id                   String              @id @default(uuid())
  name                 String              // e.g. "Augmentin 625 Duo Tablet"
  brand                String              // "GSK"
  genericName          String              // "Amoxycillin (500mg) + Clavulanic Acid (125mg)"
  strength             String              // "625mg"
  dosageForm           String              // "Tablet", "Syrup", "Ointment", "Capsule", "Drops"
  packSize             String              // "10 Tablets per strip"
  manufacturer         String              // "GlaxoSmithKline Pharmaceuticals Ltd"
  mrpPaise             Int
  sellingPricePaise    Int
  classification       String              @default("SCHEDULE_H") // OTC, SCHEDULE_H, SCHEDULE_H1, SCHEDULE_X, MEDICAL_DEVICE
  requiresPrescription Boolean             @default(true)
  isProhibitedOnline   Boolean             @default(false)
  storageRequirement   String?             @default("Store below 25°C in a dry place")
  imageUrl             String?
  barcode              String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  inventories          PharmacyInventory[]
}

model PharmacyInventory {
  id                String    @id @default(uuid())
  pharmacyId        String
  pharmacy          Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicineId        String
  medicine          Medicine  @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchNumber       String
  expiryDate        DateTime
  stockQuantity     Int       @default(0)
  mrpPaise          Int
  sellingPricePaise Int
  isAvailable       Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Prescription {
  id                 String                 @id @default(uuid())
  prescriptionNumber String                 @unique // e.g. "RX-202611-1001"
  customerId         String
  customer           User                   @relation("CustomerPrescriptions", fields: [customerId], references: [id], onDelete: Cascade)
  pharmacyId         String?
  pharmacy           Pharmacy?              @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  status             String                 @default("SUBMITTED") // DRAFT, UPLOADED, SUBMITTED, UNDER_PHARMACIST_REVIEW, ADDITIONAL_INFO_REQUIRED, APPROVED, PARTIALLY_APPROVED, REJECTED, AWAITING_CUSTOMER_CONFIRMATION, ORDER_CREATED, DISPENSED, COMPLETED, CANCELLED
  patientName        String
  patientAge         Int
  patientGender      String                 // MALE, FEMALE, OTHER
  patientRelation    String                 @default("Self") // Self, Parent, Child, Spouse, Other
  doctorName         String?
  doctorRegNumber    String?
  clinicHospital     String?
  prescriptionDate   DateTime?
  customerNotes      String?
  pharmacistNotes    String?
  rejectionReason    String?
  deliveryAddress    String?
  deliveryType       String                 @default("HOME_DELIVERY") // HOME_DELIVERY, COUNTER_PICKUP
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  documents          PrescriptionDocument[]
  reviews            PrescriptionReview[]
  quotations         PharmacyQuotation[]
  order              PharmacyOrder?
  auditEvents        PrescriptionAuditEvent[]
}

model PrescriptionDocument {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  pageNumber     Int          @default(1)
  fileName       String
  fileType       String       // image/jpeg, image/png, application/pdf
  fileSizeBytes  Int
  storagePath    String       // Non-public server path
  createdAt      DateTime     @default(now())
}

model PrescriptionReview {
  id               String       @id @default(uuid())
  prescriptionId   String
  prescription     Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  pharmacistId     String
  pharmacistName   String
  pharmacistRegNo  String
  decision         String       // APPROVED, PARTIALLY_APPROVED, REJECTED, INFO_REQUESTED
  doctorVerified   Boolean      @default(false)
  validityVerified Boolean      @default(false)
  notes            String?
  rejectionReason  String?
  reviewTimestamp  DateTime     @default(now())
}

model PharmacyQuotation {
  id                       String          @id @default(uuid())
  quotationNumber          String          @unique // e.g. "QT-202611-1001"
  prescriptionId           String
  prescription             Prescription    @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  pharmacyId               String
  pharmacy                 Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  status                   String          @default("PENDING_CUSTOMER") // PENDING_CUSTOMER, ACCEPTED, EXPIRED, REJECTED
  subtotalPaise            Int
  taxPaise                 Int             @default(0)
  deliveryFeePaise         Int             @default(0)
  totalPaise               Int
  deliveryType             String          @default("HOME_DELIVERY")
  estimatedDeliveryMinutes Int             @default(30)
  validUntil               DateTime
  pharmacistNotes          String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  items                    QuotationItem[]
}

model QuotationItem {
  id                 String            @id @default(uuid())
  quotationId        String
  quotation          PharmacyQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  medicineId         String?
  medicineName       String
  dosageStrength     String
  prescribedQuantity Int
  approvedQuantity   Int
  unitPricePaise     Int
  totalPricePaise    Int
  isAvailable        Boolean           @default(true)
  substitutionNote   String?
}

model PharmacyOrder {
  id                    String             @id @default(uuid())
  orderNumber           String             @unique // e.g. "RXORD-202611-1001"
  prescriptionId        String             @unique
  prescription          Prescription       @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  pharmacyId            String
  pharmacy              Pharmacy           @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  customerId            String
  customer              User               @relation("CustomerPharmacyOrders", fields: [customerId], references: [id], onDelete: Cascade)
  totalAmountPaise      Int
  status                String             @default("CONFIRMED") // CONFIRMED, DISPENSING, READY_FOR_PICKUP, OUT_FOR_DELIVERY, DELIVERED, COMPLETED, CANCELLED
  deliveryType          String             @default("HOME_DELIVERY")
  deliveryAddress       String?
  paymentStatus         String             @default("CASH_ON_DELIVERY")
  dispensedByPharmacist String?
  dispensedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  dispensingRecords     DispensingRecord[]
}

model DispensingRecord {
  id                 String        @id @default(uuid())
  orderId            String
  order              PharmacyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pharmacistId       String
  pharmacistName     String
  pharmacistRegNo    String
  medicineName       String
  batchNumber        String
  expiryDate         String
  quantityDispensed  Int
  dispenseTimestamp  DateTime      @default(now())
}

model PrescriptionAuditEvent {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  actorId        String
  actorRole      String       // CUSTOMER, PHARMACIST, ADMIN, SYSTEM
  actorName      String?
  action         String       // CREATED, DOCUMENT_UPLOADED, VIEWED, DOWNLOADED, REVIEWED, QUOTATION_ISSUED, ACCEPTED, DISPENSED, CANCELLED
  ipAddress      String?
  details        String?
  createdAt      DateTime     @default(now())
}

