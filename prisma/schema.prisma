}

model DeliveryIncident {
  id              String        @id @default(uuid())
  taskId          String?
  task            DeliveryTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  partnerId       String
  partner         RiderProfile  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  incidentType    String        // CUSTOMER_UNREACHABLE, MERCHANT_DELAY, ADDRESS_INACCURATE, VEHICLE_BREAKDOWN, ACCIDENT, DAMAGED_GOODS, CASH_DISCREPANCY, EMERGENCY_OFFLINE
  description     String
  photoUrl        String?
  status          String        @default("OPEN") // OPEN, INVESTIGATING, RESOLVED, DISMISSED
  reportedAt      DateTime      @default(now())
  resolvedAt      DateTime?
  resolutionNotes String?
  adminAction     String?
}

model RiderEarningLedger {
  id               String           @id @default(uuid())
  riderId          String
  rider            RiderProfile     @relation(fields: [riderId], references: [id], onDelete: Cascade)
  deliveryTaskId   String?
  deliveryTask     DeliveryTask?    @relation(fields: [deliveryTaskId], references: [id], onDelete: SetNull)
  type             String           // BASE_PAYOUT, ADDITIONAL_PICKUP, WAITING_PAYOUT, PEAK_INCENTIVE, RAIN_INCENTIVE, DEDUCTION, ADJUSTMENT, SETTLEMENT_PAYOUT
  amountPaise      Int
  description      String
  settlementStatus String           @default("UNSETTLED") // UNSETTLED, SETTLED, ON_HOLD
  settlementId     String?
  settlement       RiderSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
}

model RiderSettlement {
  id                 String               @id @default(uuid())
  riderId            String
  rider              RiderProfile         @relation(fields: [riderId], references: [id], onDelete: Cascade)
  periodStart        DateTime
  periodEnd          DateTime
  totalEarningsPaise Int
  deductionsPaise    Int                  @default(0)
  netPayoutPaise     Int
  payoutMethod       String               @default("BANK_TRANSFER")
  payoutReference    String?
  status             String               @default("PROCESSED") // PENDING, PROCESSED, COMPLETED
  processedAt        DateTime             @default(now())

  entries            RiderEarningLedger[]
}

// 3. Dynamic Delivery Pricing Rules
model DeliveryPricingRule {
  id                        String   @id @default(uuid())
  tierCode                  String   @unique // EXPRESS_20, PRIORITY_40, STANDARD_60, SCHEDULED_120
  displayName               String
  targetMinutes             Int
  baseDeliveryPaise         Int      // e.g. 3500 (₹35)
  perKmPaise                Int      // e.g. 1000 (₹10/km after 1km)
  prioritySurchargePaise    Int      // e.g. 2000 (₹20 for express)
  maxRoadDistanceKm         Float    // e.g. 3.0
  additionalPickupPaise     Int      @default(1500) // ₹15 per extra store
  weightSurchargePaisePerKg Int      @default(500)  // ₹5 per kg above 5kg
  peakMultiplier            Float    @default(1.0)
  isActive                  Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
