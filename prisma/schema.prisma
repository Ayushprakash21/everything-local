  updatedAt          DateTime     @updatedAt
}

model DeliveryPartnerVehicle {
  id                     String       @id @default(uuid())
  partnerId              String
  partner                RiderProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  vehicleType            String       // BICYCLE, MOTORCYCLE, SCOOTER, EV
