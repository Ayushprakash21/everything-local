// 1. Unified Multi-Store Parent-Child Order Model
model ParentOrder {
  id                     String                 @id @default(uuid())
  orderNumber            String                 @unique // e.g. EL-ORD-2026-9812
  customerId             String
  customer               User                   @relation("CustomerParentOrders", fields: [customerId], references: [id])
  status                 String                 @default("PLACED") // PLACED, CONFIRMED, PARTIALLY_FULFILLED, COMPLETED, CANCELLED
  paymentStatus          String                 @default("PAID") // PENDING, PAID, PARTIALLY_REFUNDED, REFUNDED, FAILED
  paymentMethod          String                 @default("ONLINE") // ONLINE, UPI, COD, CARD
  deliveryTier           String                 @default("STANDARD_60") // EXPRESS_20, PRIORITY_40, STANDARD_60, SCHEDULED_120
  deliveryAddress        String
  deliveryLatitude       Float?
  deliveryLongitude      Float?
  deliveryEtaMinutes     Int                    @default(45)
  totalItemSubtotalPaise Int
  totalDeliveryFeePaise  Int                    @default(0)
  totalDiscountPaise     Int                    @default(0)
  totalTaxPaise          Int                    @default(0)
  totalPaidPaise         Int
  refundedAmountPaise    Int                    @default(0)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

