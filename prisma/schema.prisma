  childOrderNumber     String                   @unique // e.g. EL-ORD-2026-9812-M1
  status               String                   @default("PENDING_ACCEPTANCE") // PENDING_ACCEPTANCE, ACCEPTED, REJECTED, PREPARING, READY_FOR_PICKUP, PICKED_UP, DELIVERED, CANCELLED
