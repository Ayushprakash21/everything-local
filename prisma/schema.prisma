// 9. Merchant Partner Self-Service Onboarding & Statutory Compliance
model MerchantApplication {
  id                         String                      @id @default(uuid())
  referenceNumber            String                      @unique // e.g. "EL-MAPP-1002"
  userId                     String
  user                       User                        @relation("UserMerchantApplications", fields: [userId], references: [id], onDelete: Cascade)
  status                     String                      @default("DRAFT") // DRAFT, CONTACT_VERIFICATION_PENDING, KYC_PENDING, BANK_DETAILS_PENDING, BANK_VERIFICATION_PENDING, STORE_SETUP_PENDING, CATALOGUE_PENDING, SUBMITTED, UNDER_REVIEW, ACTION_REQUIRED, APPROVED, REJECTED, SUSPENDED, ACTIVE
  currentStep                Int                         @default(1)
  completionPct              Int                         @default(10)
  
  // Step 1: Owner Information
  ownerName                  String
  ownerPhone                 String
  ownerEmail                 String
  isPhoneVerified            Boolean                     @default(false)
  isEmailVerified            Boolean                     @default(false)
  communicationConsent       Boolean                     @default(true)
  
  // Step 2: Business Information
  businessName               String?
  legalName                  String?
  entityType                 String?                     // PROPRIETORSHIP, PARTNERSHIP, LLP, PRIVATE_LIMITED, OTHER
  panNumber                  String?
  isGstRegistered            Boolean                     @default(false)
  gstin                      String?
  businessRegistrationNumber String?
  
  // Step 3: Store Information
  storeName                  String?
  category                   String?                     @default("grocery")
  description                String?
  addressLine                String?
  city                       String?                     @default("Indore")
  district                   String?                     @default("Indore")
  state                      String?                     @default("Madhya Pradesh")
  pincode                    String?
  latitude                   Float?                      @default(22.7196)
  longitude                  Float?                      @default(75.8577)
  storePhotos                String?                     // Comma-separated or JSON array of image URLs
  storeLogoUrl               String?
  storeCoverPhoto            String?
  openingTime                String?                     @default("09:00")
  closingTime                String?                     @default("21:00")
  weeklyClosingDay           String?                     @default("None")
  
  // Step 4: Delivery Configuration
  hasPickup                  Boolean                     @default(true)
  hasMerchantDelivery        Boolean                     @default(false)
  hasPlatformDelivery        Boolean                     @default(true)
  deliveryRadiusKm           Float                       @default(3.0)
  minOrderValuePaise         Int                         @default(29900)
  estimatedPrepMinutes       Int                         @default(20)
  deliveryOperatingHours     String?                     @default("09:00 - 21:00")
  
  // Statutory Licenses (Category Specific)
  fssaiNumber                String?
  drugLicenseNumber          String?
  
  // Draft Product Catalogue Setup during Onboarding
  productsCatalogueJson      String?                     // JSON string of preliminary catalogue items added before activation
  initialProductsCount       Int                         @default(0)

  // Commercial Agreement Configuration
  commissionRatePct          Float                       @default(3.5)
  listingFeePaise            Int                         @default(0)
  settlementFrequency        String                      @default("T_PLUS_1") // DAILY, T_PLUS_1, WEEKLY
  
  // Admin Review & Feedback
  adminFeedback              String?
  rejectionReason            String?
  reviewedByAdminId          String?
  reviewedAt                 DateTime?
  approvedAt                 DateTime?
  
  // Activated Store Association upon Approval
  activatedStoreId           String?
  activatedStore             Store?                      @relation("StoreMerchantApplications", fields: [activatedStoreId], references: [id], onDelete: SetNull)
  
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  // Relationships
  documents                  MerchantDocument[]
  bankAccount                MerchantBankAccount?
  agreementAcceptance        MerchantAgreementAcceptance?
  history                    MerchantOnboardingHistory[]
}

model MerchantDocument {
  id                 String              @id @default(uuid())
  applicationId      String
  application        MerchantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentType       String              // PAN_CARD, GST_CERTIFICATE, BUSINESS_REGISTRATION, CANCELLED_CHEQUE, STORE_PHOTO, FSSAI_LICENSE, DRUG_LICENSE, ADDRESS_PROOF, OTHER
  fileName           String
  fileUrl            String
  fileSizeBytes      Int
  mimeType           String
  verificationStatus String              @default("PENDING") // NOT_UPLOADED, UPLOADED, UNDER_REVIEW, VERIFIED, REJECTED, RESUBMISSION_REQUIRED
  adminComment       String?
  rejectionReason    String?
  isProtected        Boolean             @default(true)
  uploadedAt         DateTime            @default(now())
}

model MerchantBankAccount {
  id                          String              @id @default(uuid())
  applicationId               String              @unique
  application                 MerchantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  accountHolderName           String
  bankName                    String
  branchName                  String?
  accountType                 String              @default("CURRENT") // SAVINGS, CURRENT
  accountNumber               String              // Encrypted or restricted bank account number (AES-256-GCM)
  accountNumberMasked         String              // Formatted masked string: e.g. "•••• •••• 5678"
  ifsc                        String
  ownershipDeclaration        Boolean             @default(true)
  chequeDocumentUrl           String?
  verificationStatus          String              @default("PENDING") // NOT_ADDED, PENDING, VERIFIED, REJECTED, MANUAL_REVIEW
  pennyDropRef                String?             // External banking / penny-drop provider reference
  pennyDropBeneficiaryName    String?             // Beneficiary name returned by bank network
  pennyDropMatchScore         Float?              // Name match confidence score
  pennyDropStatus             String              @default("NOT_INITIATED") // NOT_INITIATED, SUCCESS, FAILED, MANUAL_REVIEW
  verificationMethod          String              @default("AUTOMATED_PENNY_DROP") // AUTOMATED_PENNY_DROP, MANUAL_ADMIN
  verifiedByAdminId           String?
  rejectionReason             String?
  lastReverificationTriggeredAt DateTime?
  auditTrail                  String?             // JSON string of bank detail change events
  verifiedAt                  DateTime?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
}

model MerchantAgreement {
  id            String   @id @default(uuid())
  version       String   @unique // e.g. "v2026.1"
  title         String
  content       String
  categoryRates String   // JSON string of category commission rates
  effectiveFrom DateTime @default(now())
  isActive      Boolean  @default(true)
}

model MerchantAgreementAcceptance {
  id               String              @id @default(uuid())
  applicationId    String              @unique
  application      MerchantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  agreementVersion String
  merchantName     String
  merchantEmail    String
  acceptedAt       DateTime            @default(now())
  ipAddress        String?
  userAgent        String?
}

model MerchantOnboardingHistory {
  id            String              @id @default(uuid())
  applicationId String
  application   MerchantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    String
  toStatus      String
  actorRole     String              // MERCHANT, ADMIN, SYSTEM
  actorId       String?
  notes         String?
  timestamp     DateTime            @default(now())
}




