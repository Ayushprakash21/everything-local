model DeliveryLocation {
  id             String        @id @default(uuid())
  partnerId      String
  partner        RiderProfile  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  taskId         String?
  task           DeliveryTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  latitude       Float
  longitude      Float
  accuracyMeters Float?
  speedKmph      Float?
  headingDegrees Float?
  recordedAt     DateTime      @default(now())
}

model DeliveryStatusHistory {
  id         String       @id @default(uuid())
  taskId     String
  task       DeliveryTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus   String
  actorRole  String       // RIDER, ADMIN, SYSTEM, MERCHANT
  actorId    String?
  latitude   Float?
  longitude  Float?
  notes      String?
  timestamp  DateTime     @default(now())
}

model DeliveryProof {
  id                   String       @id @default(uuid())
  taskId               String       @unique
  task                 DeliveryTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  pickupConfirmedAt    DateTime?
  deliveryConfirmedAt  DateTime?
  deliveryOtpProvided  String?
