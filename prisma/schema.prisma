  commissionRatePct    Float                    @default(5.0)
  commissionPaise      Int                      @default(0)
  merchantPayablePaise Int                      @default(0)
  rejectionReason      String?
  acceptedAt           DateTime?
  readyAt              DateTime?
  deliveredAt          DateTime?
