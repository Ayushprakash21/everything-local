DATABASE_URL="file:./dev.db"
PORT=4000
NODE_ENV=development

# P0 Security: Provide a high-entropy secret (>=32 characters) in production
# Example generation: openssl rand -base64 32
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_32_CHARACTERS_LONG_SECRET"

# Allowed CORS origins for production (comma-separated)
ALLOWED_ORIGINS="http://localhost:5173,https://everythinglocal.in"

# One-time super-admin bootstrap token (optional, secures /api/auth/bootstrap-admin)
ADMIN_BOOTSTRAP_TOKEN="SECURE_BOOTSTRAP_TOKEN_FOR_FIRST_SETUP"

# Hyperlocal default rules
MIN_ORDER_VALUE_PAISE=29900
DEFAULT_COMMISSION_PCT=3.5
DEFAULT_RADIUS_KM=3.0
